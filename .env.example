# ─────────────────────────────────────────────────────────────
# SchedGO — API environment variables
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/scheduleDB

# Port the server listens on
PORT=3001

# Secret used to sign JWTs — generate a long random value, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret

# Allowed CORS origin (the web client)
FRONTEND_URL=http://localhost:3000

# development | production  (production makes the auth cookie Secure)
NODE_ENV=development
